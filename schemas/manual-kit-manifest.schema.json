{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "手动申请材料包清单",
  "type": "object",
  "required": ["jobs"],
  "properties": {
    "title": {"type": "string"},
    "jobs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rank", "folder", "company", "title", "url", "role_kind", "pdfs"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "folder": {"type": "string", "minLength": 1},
          "company": {"type": "string"},
          "title": {"type": "string"},
          "url": {"type": "string", "format": "uri", "pattern": "^https://"},
          "apply_url": {"type": ["string", "null"]},
          "role_kind": {"enum": ["full_time", "internship", "unknown"]},
          "known_gaps": {"type": "string"},
          "pdfs": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["document", "pdf", "sha256", "visual_review"],
              "properties": {
                "document": {"type": "string"},
                "pdf": {"type": "string"},
                "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
                "visual_review": {"enum": ["pending", "passed"]}
              }
            }
          }
        }
      }
    },
    "supporting_documents": {
      "type": "array",
      "items": {
        "type": "object", "required": ["filename", "sha256"],
        "properties": {"filename": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}}
      }
    }
  }
}
