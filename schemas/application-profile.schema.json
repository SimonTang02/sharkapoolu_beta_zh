{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SimonTang02/sharkapoolu_beta_zh/main/schemas/application-profile.schema.json",
  "title": "申请者档案",
  "description": "候选人事实与已明确审阅的申请答案。此文件应保存在私有目录中。",
  "type": "object",
  "required": ["schema_version", "fields", "documents", "safety"],
  "properties": {
    "schema_version": {"const": 1, "description": "档案格式版本。"},
    "fields": {
      "type": "object",
      "description": "稳定的身份与联系信息。留空表示未知，不得推断。",
      "properties": {
        "how_did_you_hear": {"oneOf": [{"type": "string"}, {"type": "array", "items": {"type": "string"}}]},
        "previous_nvidia_worker": {"type": ["boolean", "null"]},
        "first_name": {"type": "string"},
        "last_name": {"type": "string"},
        "preferred_name": {"type": "string"},
        "chinese_name": {"type": "string"},
        "native_first_name": {"type": "string"},
        "native_last_name": {"type": "string"},
        "email": {"type": "string"},
        "phone": {"type": "string"},
        "address_line_1": {"type": "string"},
        "city": {"type": "string"},
        "postal_code": {"type": "string"},
        "country": {"type": "string"},
        "date_of_birth": {"type": "string", "description": "使用 YYYY-MM-DD 格式，或留空。"},
        "linkedin_url": {"type": "string"},
        "github_url": {"type": "string"}
      },
      "additionalProperties": true
    },
    "documents": {
      "type": "object",
      "description": "默认私有材料路径；单个岗位档案可以覆盖。",
      "properties": {
        "resume_path": {"type": "string"},
        "cover_letter_path": {"type": "string"}
      },
      "additionalProperties": false
    },
    "education": {"type": "array", "items": {"$ref": "#/$defs/datedRecord"}},
    "languages": {"type": "array", "items": {"type": "object"}},
    "work_experience": {"type": "array", "items": {"$ref": "#/$defs/datedRecord"}},
    "projects": {"type": "array", "items": {"$ref": "#/$defs/datedRecord"}},
    "skills": {"type": "array", "items": {"type": "string"}},
    "workday_checkbox_groups": {
      "type": "object",
      "description": "按逻辑组名称索引的门户选项组。值必须是已审阅的准确标签。",
      "additionalProperties": {"type": "array", "items": {"type": "string"}}
    },
    "custom_answers": {
      "type": "object",
      "description": "将门户中的确切问题文本映射到已审阅答案。null 表示尚未回答。",
      "additionalProperties": {"type": ["string", "boolean", "number", "null"]}
    },
    "answer_rules": {"type": "array", "description": "针对不同措辞变体的基于模式的已审阅答案。", "items": {"type": "object"}},
    "voluntary_disclosures": {"type": "object"},
    "explicit_authorization": {
      "type": "object",
      "description": "用户确认的工作授权范围。居住国家不代表拥有工作授权。",
      "properties": {
        "user_confirmed": {"type": "boolean"},
        "location_scopes": {"type": "array", "items": {"enum": ["mainland_china", "hong_kong", "united_states"]}},
        "work_authorized": {"type": ["boolean", "null"]},
        "sponsorship_required": {"type": ["boolean", "null"]},
        "company_consents": {"type": "object", "additionalProperties": {"type": "boolean"}}
      },
      "additionalProperties": true
    },
    "career_preferences": {"type": "object"},
    "personal_facts_confirmation": {
      "type": "object",
      "description": "可选的带日期来源记录，用于保存经候选人确认但尚无专用字段的事实。"
    },
    "safety": {
      "type": "object",
      "required": ["allow_sensitive_answers", "allow_server_draft", "allow_submit"],
      "properties": {
        "allow_sensitive_answers": {"type": "boolean"},
        "allow_server_draft": {"type": "boolean"},
        "allow_submit": {"const": false, "description": "共享自动化约定始终禁止最终提交。"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "datedRecord": {
      "type": "object",
      "properties": {
        "from_month": {"type": ["integer", "null"], "minimum": 1, "maximum": 12},
        "from_year": {"type": ["integer", "null"]},
        "to_month": {"type": ["integer", "null"], "minimum": 1, "maximum": 12},
        "to_year": {"type": ["integer", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
