{
  "includes": ["../jobbot.json"],
  "experiment": {
    "name": "keyword_tuning_example",
    "hypothesis": "提高 RTL/CDC 直接证据的权重，并测试更小的 JobsDB 页面抓取上限。"
  },
  "patches": [
    {
      "path": "scoring.foundation_groups",
      "match": {"name": "digital RTL design"},
      "set": {
        "base_score": 76,
        "keywords": {"$append": ["clock-domain crossing", "CDC", "AMBA", "AXI"]}
      }
    },
    {
      "path": "sources",
      "match": {"name": "JobsDB HK - Electronics Internships"},
      "set": {"max_pages": 2}
    }
  ]
}
